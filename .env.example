# Local Supabase (from `npx supabase status`)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Client-safe public keys (Expo / Next.js browser)
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Stripe — Bridge-Hive same project (hfnymqjrbppculcofaag)
# Live lane (server-only). Never overwrite hosted live secrets with test values.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_MODE=

# Sandbox lane — separately named (same project Edge secrets / local .env.local)
STRIPE_TEST_SECRET_KEY=
STRIPE_TEST_WEBHOOK_SECRET=

APP_PUBLIC_URL=http://127.0.0.1:8081
# Optional comma-separated extra Checkout return origins (localhost/127.0.0.1 always allowed)
CHECKOUT_ALLOWED_ORIGINS=

# Mobile publishable key (client-safe). pk_test_ for sandbox TestFlight/preview only.
# EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# EXPO_PUBLIC_STRIPE_PAYMENTS_MODE=sandbox

