{
  "name": "bridge-hive",
  "version": "0.1.0",
  "private": true,
  "description": "Bridge Hive healthcare shift marketplace monorepo",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "supabase:start": "npx supabase start",
    "supabase:stop": "npx supabase stop",
    "supabase:reset": "npx supabase db reset",
    "supabase:status": "npx supabase status",
    "db:types": "npx supabase gen types typescript --local > packages/supabase-types/src/database.generated.ts",
    "test:db": "npx supabase test db",
    "typecheck": "npx tsc -p tsconfig.json",
    "lint": "npx tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.8.2"
  },
  "engines": {
    "node": ">=20"
  }
}
