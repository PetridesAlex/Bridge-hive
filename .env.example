# Local Supabase (from `npx supabase status`)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Client-safe public keys (Expo / Next.js browser)
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Stripe test mode (server-only — never put secrets in mobile EXPO_PUBLIC_* vars)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
APP_PUBLIC_URL=http://127.0.0.1:8081
# Optional comma-separated extra Checkout return origins (localhost/127.0.0.1 always allowed)
CHECKOUT_ALLOWED_ORIGINS=
