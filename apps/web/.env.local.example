# Copy to .env.local and fill from hosted Supabase / local `npx supabase status`
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public app origin for Auth redirects — MUST match the browser origin you test with.
# Mac local testing: use http://localhost:3000 (not 127.0.0.1) so cookies match.
# Vercel Preview: set to the exact https://<deployment>.vercel.app origin, or omit and
# rely on automatic https://$VERCEL_URL fallback in getAppPublicUrl().
# Later staging/production: your real https://app.<domain> origin.
APP_PUBLIC_URL=http://localhost:3000

# Server-only — NEVER prefix with NEXT_PUBLIC_ or EXPO_PUBLIC_
# Required for Platform Admin organization activation emails (Auth Admin API)
SUPABASE_SERVICE_ROLE_KEY=

# Local development only: return a one-time copyable invitation link in the admin UI
# Omit or leave false on Vercel.
ALLOW_LOCAL_INVITE_LINK_COPY=false

# Stripe test mode (server-only — used by Edge Functions / future API routes)
# Not required for apps/web UI preview on Vercel.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
